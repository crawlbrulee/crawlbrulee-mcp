{
  "name": "@crawlbrulee/mcp",
  "version": "1.0.1",
  "description": "official mcp server for crawlbrulee — EU-native web scraping for AI agents & developers. native scrape and map tools for your agent.",
  "keywords": [
    "crawlbrulee",
    "mcp",
    "model-context-protocol",
    "scrape",
    "scraping",
    "crawler",
    "web-scraping",
    "screenshot",
    "sitemap",
    "claude",
    "cursor",
    "codex",
    "eu",
    "gdpr",
    "ai-agents",
    "llm",
    "rag",
    "markdown"
  ],
  "license": "Apache-2.0",
  "homepage": "https://crawlbrulee.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crawlbrulee/crawlbrulee-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/crawlbrulee/crawlbrulee-mcp/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "bin": {
    "crawlbrulee-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist coverage node_modules",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@crawlbrulee/sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.22.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.6"
  }
}
